FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install curl, bzip2, libudev-dev, pkg-config, build-essential
RUN apt-get update && apt-get install -y \
    curl \
    bzip2 \
    ca-certificates \
    git \
    libudev-dev \
    pkg-config \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Solana / Agave CLI 2.1.21
RUN sh -c "$(curl -sSfL https://release.anza.xyz/v2.1.21/install)"
ENV PATH="/root/.local/share/solana/install/active_release/bin:${PATH}"

# Copy workspace project files into deployer image
COPY target/ /app/target/
COPY programs/ /app/programs/
COPY Anchor.toml /app/Anchor.toml
COPY scripts/deploy.sh /app/scripts/deploy.sh

RUN chmod +x /app/scripts/deploy.sh

ENTRYPOINT ["/app/scripts/deploy.sh"]
