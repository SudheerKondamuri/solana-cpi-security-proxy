TARGET_PROGRAM_ID=C8dbWuj9rvbUhR4v6Gkh3va8tpQrYvcp7qgE6shYzAoQ

# Optional: Path to custom fee-payer keypair (defaults to ~/.config/solana/id.json)
# RELAYER_KEYPAIR_PATH=/root/.config/solana/id.json
